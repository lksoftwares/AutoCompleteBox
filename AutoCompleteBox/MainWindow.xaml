<Window x:Class="AutoCompleteBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoCompleteBox"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Select Role" Margin="0,0,0,10"/>

            <local:CustomCombo x:Name="myCombo"
                   Items="{Binding Roles}"
                   Margin="0,0,0,10" TabIndex="0"/>

            <local:CustomCombo x:Name="myCombo2"
                   Items="{Binding Classes}" TabIndex="1"/>

            <Button x:Name="btnShow" Content="Show Selected"
            Click="Button_Click" TabIndex="2"/>
        </StackPanel>
    </Grid>
</Window>