<UserControl x:Class="AutoCompleteBox.CustomCombo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="250">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

      
        <Border BorderBrush="#DADADA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="5"
                Background="White">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="25"/>
                </Grid.ColumnDefinitions>

              
                <WrapPanel  Grid.Column="0"
           VerticalAlignment="Top"
           Orientation="Horizontal"
           ItemHeight="Auto">

                    
                    <ItemsControl ItemsSource="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E0F3FF"
                                        Margin="2"
                                        Padding="5"
                                        CornerRadius="10"
                                        BorderBrush="#4FC3F7"
                                        BorderThickness="1">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Name}" Margin="0,0,5,0"/>

                                        <Button Content="✖"
                                                Width="14"
                                                Height="14"
                                                FontSize="10"
                                                Padding="0"
                                                Background="Transparent"
                                                Foreground="Black"
                                                BorderThickness="0"
                                                FocusVisualStyle="{x:Null}"
                                                CommandParameter="{Binding}"
                                                Click="RemoveItem_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                   
                    <TextBox x:Name="SearchBox"
                             Width="80"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </WrapPanel>

                
                <Border Grid.Column="1"
                        Width="20"
                        Height="20"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="DropDownToggle_Click">

                    <TextBlock Text="▼"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

            </Grid>
        </Border>


        <Border Grid.Row="1"
                Margin="0,2,0,0"
                BorderBrush="#DADADA"
                BorderThickness="1"
                CornerRadius="6"
                Background="White"
                Visibility="Collapsed"
                x:Name="ListBorder">
           
            <ListBox x:Name="List"
                     ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     PreviewMouseLeftButtonUp="List_MouseLeftButtonUp"
                     PreviewKeyDown="List_PreviewKeyDown"
                     BorderThickness="0"
                     Height="120">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="6"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

    </Grid>
</UserControl>